{
  "name": "tura-sound-app",
  "version": "0.1.0",
  "private": true,
  "author": "Tom Marienfeld <marienfeldtom@googlemail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue src",
    "cordova-build-android": "vite build --outDir src-cordova/www && cd src-cordova && cordova build android",
    "cordova-build-browser": "vite build --outDir src-cordova/www && cd src-cordova && cordova build browser",
    "cordova-build-ios": "vite build --outDir src-cordova/www && cd src-cordova && cordova build ios",
    "cordova-build-only-www-android": "vite build --outDir src-cordova/www",
    "cordova-build-only-www-browser": "vite build --outDir src-cordova/www",
    "cordova-build-only-www-ios": "vite build --outDir src-cordova/www",
    "cordova-build-only-www-osx": "vite build --outDir src-cordova/www",
    "cordova-build-osx": "vite build --outDir src-cordova/www && cd src-cordova && cordova build osx",
    "cordova-prepare": "vite build --outDir src-cordova/www && cd src-cordova && cordova prepare",
    "cordova-serve-android": "cd src-cordova && cordova run android",
    "cordova-serve-browser": "cd src-cordova && cordova run browser",
    "cordova-serve-ios": "cd src-cordova && cordova run ios",
    "cordova-serve-osx": "cd src-cordova && cordova run osx"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "core-js": "^3.39.0",
    "framework7": "^4.4.10",
    "framework7-vue": "^4.4.10",
    "lowdb": "^1.0.0",
    "vue": "^2.7.16"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.3",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.28.0",
    "vite": "^5.4.14"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "node": true,
      "es2021": true
    },
    "globals": {
      "cordova": "readonly"
    },
    "extends": [
      "eslint:recommended",
      "plugin:vue/essential"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {}
  }
}
