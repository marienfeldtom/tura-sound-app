<?xml version='1.0' encoding='utf-8'?>
<widget id="de.beugelbuddel.sevensecs" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>7secs</name>
    <description>
        7secs Sound App for quick goal celebrations
    </description>
    <author email="marienfeldtom@googlemail.com" href="https://beugelbuddel.de">
        Tom Marienfeld
    </author>
    <content src="index.html" />
    <preference name="AndroidXEnabled" value="true" />
    <access origin="*" />
    <access origin="cdvfile://*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
        <allow-intent href="market:*" />
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>
</widget>
